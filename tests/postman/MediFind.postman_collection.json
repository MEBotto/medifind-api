{
	"info": {
		"_postman_id": "721a62bd-605b-4763-9ba2-8b487a4c733e",
		"name": "MediFind API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "29410739"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "01 - Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"",
									"const response = pm.response.json();",
									"",
									"pm.test(\"Registration returns HTTP 201 Created\", () => {",
									"  pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Registration returns a user ID\", () => {",
									"  pm.expect(response.data?.user?.id).to.be.a(\"string\").and.not.empty;",
									"});",
									"",
									"pm.test(\"Registration does not expose password hash\", () => {",
									"  pm.expect(response.data?.user?.password).to.be.undefined;",
									"});",
									"",
									"pm.test(\"Registration returns the expected response code\", () => {",
									"  pm.expect(response.code).to.eql(\"AUTH_REGISTER_SUCCESS\");",
									"});",
									"",
									"if (pm.response.code === 201 && response.data?.user?.id) {",
									"  pm.environment.set(\"userId\", response.data.user.id);",
									"}",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"\r",
									"const uniqueId = Date.now().toString();\r",
									"\r",
									"pm.environment.set(\"testUsername\", `testuser_${uniqueId}`);\r",
									"pm.environment.set(\"testEmail\", `test_${uniqueId}@example.com`);\r",
									"pm.environment.set(\"testPassword\", \"TestPassword123!\");\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "\n{\n  \"username\": \"{{testUsername}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\"\n}\n"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"register"
							]
						}
					},
					"response": []
				},
				{
					"name": "02 - Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"",
									"const response = pm.response.json();",
									"",
									"// HTTP RESPONSE VALIDATION",
									"",
									"pm.test(\"Login returns HTTP 200 OK\", () => {",
									"  pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response contains a valid JWT\", () => {",
									"  pm.expect(response.data?.token)",
									"    .to.be.a(\"string\")",
									"    .and.not.empty;",
									"});",
									"",
									"pm.test(\"Response contains user information\", () => {",
									"  pm.expect(response.data?.user).to.be.an(\"object\");",
									"  pm.expect(response.data.user.id).to.be.a(\"string\").and.not.empty;",
									"  pm.expect(response.data.user.email).to.be.a(\"string\").and.not.empty;",
									"});",
									"",
									"// SECURITY VALIDATION",
									"",
									"pm.test(\"Password hash is not exposed\", () => {",
									"  pm.expect(response.data?.user?.password).to.be.undefined;",
									"});",
									"",
									"// ENVIRONMENT VARIABLES",
									"",
									"if (pm.response.code === 200 && response.data?.token) {",
									"  pm.environment.set(\"token\", response.data.token);",
									"",
									"  if (response.data.user?.id) {",
									"    pm.environment.set(\"userId\", response.data.user.id);",
									"  }",
									"}",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "\n{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}\n"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "03 - Login - Incorrect password",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Credenciales incorrectas devuelven 401', () => pm.response.to.have.status(401));"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "\n{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"IncorrectPassword123!\"\n}\n"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "04 - Users without token - 401",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Sin token devuelve 401', () => pm.response.to.have.status(401));"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users/{{userId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users",
								"{{userId}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "05 - Users with invalid token - 401",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"\r",
									"const response = pm.response.json();\r",
									"\r",
									"pm.test(\"Invalid token returns HTTP 401 Unauthorized\", () => {\r",
									"  pm.response.to.have.status(401);\r",
									"});\r",
									"\r",
									"pm.test(\"Response contains an error status\", () => {\r",
									"  pm.expect(response.status).to.eql(\"error\");\r",
									"});\r",
									"\r",
									"pm.test(\"Response contains an error code\", () => {\r",
									"  pm.expect(response.code).to.eql(\"REQUEST_FAILED\");\r",
									"});\r",
									"\r",
									"pm.test(\"Response does not expose sensitive data\", () => {\r",
									"  pm.expect(response.data).to.be.undefined;\r",
									"  pm.expect(response.token).to.be.undefined;\r",
									"});\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "invalid.token.value",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users/{{userId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users",
								"{{userId}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "06 - Users with customer token - 403",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Usuario no administrador devuelve 403', () => pm.response.to.have.status(403));"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users/{{userId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users",
								"{{userId}}"
							]
						}
					},
					"response": []
				}
			]
		}
	]
}