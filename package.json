{
  "name": "base-node-ts",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "node dist/entry-prod.js",
    "build": "tsc",
    "dev": "nodemon --exec ts-node src/entry-dev.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm migration:generate -- -d src/data-source.ts",
    "migration:run": "npm run typeorm migration:run -- -d src/data-source.ts",
    "migration:revert": "npm run typeorm migration:revert -- -d src/data-source.ts",
    "db:ensure": "ts-node -r tsconfig-paths/register src/scripts/ensure-db.ts",
    "db:wipe": "ts-node -r tsconfig-paths/register src/scripts/wipe-db.ts",
    "db:wipe:soft": "ts-node -r tsconfig-paths/register src/scripts/wipe-db.ts --soft",
    "db:wipe:force": "ts-node -r tsconfig-paths/register src/scripts/wipe-db.ts --force",
    "test": "jest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "seed:pharmacy:demo": "ts-node -r tsconfig-paths/register src/scripts/seed-pharmacy-demo.ts",
    "test:integration": "jest --runInBand --runTestsByPath src/pharmacies/pharmacy-db.integration.test.ts src/pharmacies/pharmacy-http.integration.test.ts src/users/auth-sessions.integration.test.ts",
    "seed:roles": "ts-node -r tsconfig-paths/register src/scripts/seed-roles.ts",
    "bootstrap:admin": "ts-node -r tsconfig-paths/register src/scripts/bootstrap-admin.ts",
    "db:setup:prod": "ts-node -r tsconfig-paths/register src/scripts/setup-production.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.2.3",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.1",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^1.1.3",
    "winston": "^3.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.19.4",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "supertest": "^7.3.2",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.5.0",
    "typescript-eslint": "^8.74.0"
  },
  "_moduleAliases": {
    "@": "dist"
  },
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11 <12"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
