{
  "name": "base-node-ts",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "node dist/entry-prod.js",
    "build": "tsc",
    "dev": "nodemon --exec ts-node src/entry-dev.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm migration:generate -- -d src/data-source.ts",
    "migration:run": "npm run typeorm migration:run -- -d src/data-source.ts",
    "migration:revert": "npm run typeorm migration:revert -- -d src/data-source.ts",
    "db:ensure": "ts-node -r tsconfig-paths/register src/scripts/ensure-db.ts",
    "db:wipe": "ts-node -r tsconfig-paths/register src/scripts/wipe-db.ts",
    "db:wipe:soft": "ts-node -r tsconfig-paths/register src/scripts/wipe-db.ts --soft",
    "db:wipe:force": "ts-node -r tsconfig-paths/register src/scripts/wipe-db.ts --force",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "seed:roles": "ts-node -r tsconfig-paths/register src/scripts/seed-roles.ts",
    "bootstrap:admin": "ts-node -r tsconfig-paths/register src/scripts/bootstrap-admin.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.2.3",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.1",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.20",
    "winston": "^3.11.0",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "newman": "^6.2.3",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "supertest": "^7.3.2",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.5.0"
  },
  "_moduleAliases": {
    "@": "dist"
  }
}
